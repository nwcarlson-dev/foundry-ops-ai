# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> "Connection string".
# Use the pooled connection for the app; either works for the seed script.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key for the chat surface and the MCP server.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Cost guardrails (Phase 7) -----------------------------------------------
# Per-IP daily query cap for the public demo.
DEMO_DAILY_QUERY_CAP="20"
# Hard monthly output-token ceiling; the app stops calling the API past this.
DEMO_MONTHLY_TOKEN_CAP="2000000"
